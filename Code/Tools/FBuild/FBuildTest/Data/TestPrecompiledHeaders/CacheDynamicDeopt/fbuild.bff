#include "..\..\testcommon.bff"

// Settings & default ToolChain
Using( .StandardEnvironment )
Settings {} // use Standard Environment

#if MSVC_DYNAMIC_DEOPT_AVAILABLE
    ObjectList( "PCHTest-CacheDynamicDeopt-lib" )
    {
        // PCH
        .PCHInputFile               = "Tools/FBuild/FBuildTest/Data/TestPrecompiledHeaders/CacheDynamicDeopt/PrecompiledHeader.cpp"
        .PCHOutputFile              = "$Out$/Test/PrecompiledHeaders/CacheDynamicDeopt/PrecompiledHeader.pch"
        .PCHOptions                 + ' "/ITools/FBuild/FBuildTest/Data/TestPrecompiledHeaders/CacheDynamicDeopt"'
                                    + ' /dynamicdeopt'

        // PCH User
        .CompilerInputPath          = "Tools/FBuild/FBuildTest/Data/TestPrecompiledHeaders/CacheDynamicDeopt/"
        .CompilerOutputPath         = "$Out$/Test/PrecompiledHeaders/CacheDynamicDeopt/"
        .CompilerOptions            + ' /Yu"PrecompiledHeader.h" /Fp"$PCHOutputFile$"'
                                    + ' "/ITools/FBuild/FBuildTest/Data/TestPrecompiledHeaders/CacheDynamicDeopt"'
                                    + ' /dynamicdeopt'
    }

    Executable( "PCHTest-CacheDynamicDeopt" )
    {
        .LinkerOptions      + ' /ENTRY:main'
                            + ' /DYNAMICDEOPT:SYNC'
        .LinkerOutput       = "$Out$/Test/PrecompiledHeaders/CacheDynamicDeopt/PCHTest.exe"
        .Libraries          = { "PCHTest-CacheDynamicDeopt-lib" }
    }
#else
    #error Dynamic Deoptimization not available
#endif
